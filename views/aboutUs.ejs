<!DOCTYPE html>
<html>
  
  <%- include('includes/head') %>

  <body>

    <%- include('includes/bar') %>

    <div class="hero">
      <div class="heroImage">
        <img src="/img/stock/contactus.jpg" alt="Contact us image." class="heroImage" style="width:100%; height:810px;">
      </div>

      <div class="heroHead4">
        <a>About Us</a>
      </div>

      <div class="custom-shape-divider-bottom-1757185959">
        <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M892.25 114.72L0 0 0 120 1200 120 1200 0 892.25 114.72z" class="shape-fill"></path>
        </svg>
      </div>
    </div>

    <div class="memberText">Members of CWPS and CIF</div>
    <div class="memberImg">
      <img src="img/stock/memberImg.png" alt="5 Terre" style="width:35%; height:35%">
    </div>

    <div class="messageUs">Contact Us</div>

    <div class="contactForm">
      <form action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="f638d36c-c413-4c45-9057-c5611fba9fce">
        <div class="formName">
          <label for="name">Name:</label><br>
          <input type="text" name="name" placeholder="Name..." required><br>
        </div>

        <div class="emailForm">
          <label for="email">Email:</label><br>
          <input type="email" name="email" placeholder="example@gmail.com" required><br>
        </div>

        <div class="messageForm">
          <label for="message">Message:</label><br>
          <textarea name="message" required placeholder="Message..."></textarea><br>
        </div>

        <input type="submit" value="Submit">
        </form>
    </div>

    <div class="infoP2">

      <div class="info4">
        <div class="infoBox1">
          <div class="officeIcon"></div>
        </div>
        <div class="infoTitle">Office</div>
        <div class="infoDesc">Rathbourne, Dublin 15</div>
      </div>

      <div class="info5">
        <div class="infoBox2">
          <div class="phoneIcon"></div>
        </div>
        <div class="infoTitle">Phone</div>
        <div class="infoDesc">(01) 899 6210</div>
      </div>

      <div class="info6">
        <div class="infoBox3">
          <div class="mailIcon"></div>
        </div>
        <div class="infoTitle">E-mail</div>
        <div class="infoDesc">info@burkepfp.com</div>
      </div>

    </div>

    <%- include('includes/footer') %>
  
  </body>
  
</html>